rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // SECURITY WARNING: These rules allow unrestricted read/write access
    // This is only suitable for a small, private family app with a shared login
    // 
    // For production use, consider:
    // 1. Implementing proper Firebase Authentication
    // 2. Restricting write access to authenticated users only
    // 3. Adding validation rules for data structure
    // 4. Enabling Firebase App Check for additional security
    //
    // Example secure rules:
    // match /predictions/{predictionId} {
    //   allow read: if request.auth != null;
    //   allow write: if request.auth != null && 
    //     request.auth.uid == request.resource.data.userId;
    // }
    
    match /predictions/{document=**} {
      allow read: if true;
      allow write: if true;
    }
  }
}
